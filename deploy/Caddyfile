# Caddy v2 — automatic HTTPS for all domains below.
# /api/* goes to the Go backend, everything else to Next.js.
#
# IMPORTANT: every hostname here MUST have a DNS record in Cloudflare,
# otherwise Caddy fails to obtain its certificate and spams retry errors.
# Adding a new niche domain = DNS record + this file + frontend/src/lib/niches.ts.

(zilobook) {
	encode gzip

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:3000
	}
}

zilobook.com,
nails.zilobook.com,
fit.zilobook.com,
app.zilobook.com {
	import zilobook
}

www.zilobook.com {
	redir https://zilobook.com{uri} permanent
}

# Future niche domains — uncomment after creating their DNS records:
# beauty.zilobook.com, trainer.zilobook.com, auto.zilobook.com {
# 	import zilobook
# }
