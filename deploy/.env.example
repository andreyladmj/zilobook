# Copy to the repo root on the server as `.env` (next to docker-compose.prod.yml)
# and fill in real values. NEVER commit the real .env.

# Postgres password (generate: openssl rand -hex 24)
POSTGRES_PASSWORD=

# JWT signing secret (generate: openssl rand -hex 32). Backend refuses default value in prod.
JWT_SECRET=

# Comma-separated allowed origins (mostly redundant now that API is same-origin, but keep accurate)
CORS_ORIGIN=https://zilobook.com,https://nails.zilobook.com,https://app.zilobook.com

# Telegram bot for reminders. Create a bot via @BotFather, paste the token + bot username
# (without @). Leave BOTH empty to disable notifications entirely (dev default).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
